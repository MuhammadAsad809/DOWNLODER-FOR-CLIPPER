<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude imported cookies and sensitive authentication data from cloud backup -->
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="cookies" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude cookies from device-to-device transfers -->
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="cookies" />
    </device-transfer>
</data-extraction-rules>
